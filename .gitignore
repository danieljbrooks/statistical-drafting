# Ignore 17lands draft data files
*.csv.gz

# Ignore training set files
*.pth

# Ignore dev notebooks
notebooks/test.ipynb
notebooks/deckbuild_model.ipynb

# Ignore auto-generated files
.ipynb_checkpoints/
.DS_Store
*.egg-info
__pycache__
build/*
training_sets/*

# Ignore trained PyTorch checkpoints
data/models/*.pt
# PyTorch/ONNX external weight shards (orphans from export; single-file .onnx is committed)
*.onnx.data

# Ignore CI training reports
model_refresh/training_report.json
model_refresh/release_notes.md
# Ignore winrate training sets and checkpoints
data/winrate_sets/
data/winrate_models/*.pt
winrate_sandbox/*.log

# Ignore RL artifacts: pack banks are regenerated from the 17lands data by
# rl_sandbox/packbank.py, and policy checkpoints are large. The per-run JSON sidecars
# (args + training history) are small and worth keeping.
data/packs/
data/rl_models/*.pt
data/rl_models/*_iter*.json
rl_sandbox/logs/
